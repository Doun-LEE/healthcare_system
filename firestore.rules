rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ───────── 공통 ─────────
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isStr(v, maxLen) { return v is string && v.size() <= maxLen; }

    // ───────── 내 데이터(앱 전체 JSON·백업) ─────────
    // 나만 읽고 쓴다. 목록 조회(list)도 본인 것만.
    match /users/{uid}/data/{doc} {
      allow read, write: if signedIn() && me() == uid;
    }

    // ───────── 공개 프로필(파트너 운동용 요약) ─────────
    // 로그인한 사람이 uid 를 알 때 하나씩(get)만 읽을 수 있다. 전체 나열(list)은 막아
    // 사용자 명단을 긁어가지 못하게 한다. 쓰기는 본인만.
    match /users/{uid}/public/{doc} {
      allow get: if signedIn();
      allow list: if signedIn() && me() == uid;
      allow write: if signedIn() && me() == uid;
    }

    // ───────── 받은편지함(파트너 요청·루틴 제안·답장) ─────────
    // 본인만 읽고 지운다. 보내는 쪽은 로그인한 누구나지만 보낸 사람(fromUid)을 속일 수 없고,
    // 종류·크기가 정해진 모양이어야 한다(스팸·대용량 방지).
    match /users/{uid}/inbox/{doc} {
      allow read, delete: if signedIn() && me() == uid;
      allow create: if signedIn()
        && request.resource.data.fromUid == me()
        && request.resource.data.type in ['joint', 'jointAccepted', 'partnerRequest', 'partnerAccept', 'partnerDecline']
        && (!('fromName' in request.resource.data) || isStr(request.resource.data.fromName, 60))
        && (!('fromHandle' in request.resource.data) || isStr(request.resource.data.fromHandle, 80))
        && (!('title' in request.resource.data) || isStr(request.resource.data.title, 200))
        && (!('date' in request.resource.data) || isStr(request.resource.data.date, 10))
        && (!('code' in request.resource.data) || isStr(request.resource.data.code, 200000));
      allow update: if false;
    }

    // ───────── 공개 ID·이메일 → uid 검색표 ─────────
    // 정확한 키를 알 때만 하나씩(get) 읽는다(list 금지 → 이메일·ID 전체 수집 불가).
    // 처음 만들 때는 자기 uid 로만, 고칠 때는 원래 주인만(남의 ID 가로채기 방지).
    function ownEntry() {
      return request.resource.data.uid == me()
        && isStr(request.resource.data.name, 60)
        && isStr(request.resource.data.handle, 80)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'handle']);
    }
    match /emails/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && ownEntry();
      allow update: if signedIn() && resource.data.uid == me() && ownEntry();
      allow delete: if signedIn() && resource.data.uid == me();
    }
    match /handles/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && ownEntry();
      allow update: if signedIn() && resource.data.uid == me() && ownEntry();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ───────── 파트너 채팅 ─────────
    // 방 이름이 "uidA_uidB"(정렬)이고, 그 둘만 읽고 쓴다. 보낸 사람을 속일 수 없고
    // 글자 수·이모티콘 폭탄 수에 상한. 수정·삭제는 없음(기록 보존).
    match /chats/{pair}/messages/{msg} {
      allow read: if signedIn() && pair.split('_').hasAny([me()]);
      allow create: if signedIn()
        && pair.split('_').hasAny([me()])
        && request.resource.data.fromUid == me()
        && isStr(request.resource.data.text, 1000)
        && isStr(request.resource.data.emoji, 16)
        && request.resource.data.burst is int
        && request.resource.data.burst >= 0 && request.resource.data.burst <= 60
        && (!('fromName' in request.resource.data) || isStr(request.resource.data.fromName, 60));
      allow update, delete: if false;
    }

    // ───────── 공유 헬스장 대표 데이터(관리자 지정) ─────────
    // 로그인한 누구나 읽고, 관리자 계정(이메일)만 쓴다.
    match /sharedGyms/{key} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.token.email == 'ehdnsdlfkrh@gmail.com'
        && isStr(request.resource.data.owner, 128) && isStr(request.resource.data.gymId, 128)
        && isStr(request.resource.data.name, 100);
    }

    // ───────── 오류 보고(앱 안 크래시 리포트) ─────────
    // 로그인한 사용자가 자기 uid 로 만들기만 할 수 있고, 아무도 읽을 수 없다(콘솔에서만 본다).
    match /errors/{id} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.uid == me()
        && isStr(request.resource.data.error, 1000)
        && isStr(request.resource.data.stack, 6000)
        && isStr(request.resource.data.where, 200)
        && isStr(request.resource.data.version, 40)
        && isStr(request.resource.data.platform, 20);
      allow update, delete: if false;
    }

    // 그 밖의 경로는 전부 거부.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
