{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fitroutine-web",
      "runtimeExecutable": "C:\\dev\\flutter\\bin\\flutter.bat",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "8765",
        "--web-hostname",
        "127.0.0.1"
