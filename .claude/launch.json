    {
      "name": "fitroutine-release",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "-d",
        "build/web",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8766
    }
  ]
}